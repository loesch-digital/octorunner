          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit derselben GitHub-Identität an, um Zugangsdaten zu ersetzen. Eine andere Identität wird als eigener Account hinzugefügt."
          }
        }
      }
    },
    "Token contents and expiration dates are not exposed here. Fine-grained PAT permissions depend on the resources you selected on GitHub.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token contents and expiration dates are not exposed here. Fine-grained PAT permissions depend on the resources you selected on GitHub."
