    "Job alerts check recent GitHub runs while OctoRunner is running. The first check establishes a baseline. Configure organization repositories under Jobs → History sources.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Job alerts check recent GitHub runs while OctoRunner is running. The first check establishes a baseline. Configure organization repositories under Jobs → History sources."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jobmeldungen prüfen aktuelle GitHub-Läufe, während OctoRunner läuft. Die erste Prüfung erfasst die Ausgangslage. Repositories für Organisationsrunner lassen sich unter Jobs → Historienquellen hinzufügen."
          }
        }
      }
    },
    "Workspace variables & build paths": {
      "extractionState": "manual",
      "localizations": {
