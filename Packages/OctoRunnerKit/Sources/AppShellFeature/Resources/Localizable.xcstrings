    "Control how OctoRunner restarts its directly managed runners.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wie OctoRunner direkt verwaltete Runner neu startet."
