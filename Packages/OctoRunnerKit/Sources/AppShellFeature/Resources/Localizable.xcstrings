    "The selected account is used for GitHub requests. Its token is checked when used; selection alone does not confirm current permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected account is used for GitHub requests. Its token is checked when used; selection alone does not confirm current permissions."
