        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops automatic recovery after this many consecutive failures."
          }
        }
      }
    },
    "New LaunchAgents use the selected restart rule and delay. Existing LaunchAgents keep their installed configuration.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue LaunchAgents verwenden die gewählte Neustartregel und Wartezeit. Bestehende LaunchAgents behalten ihre installierte Konfiguration."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New LaunchAgents use the selected restart rule and delay. Existing LaunchAgents keep their installed configuration."
          }
        }
      }
    },
