    "Stops automatic recovery after this many consecutive failures.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet die automatische Wiederherstellung nach dieser Anzahl aufeinanderfolgender Fehlversuche."
