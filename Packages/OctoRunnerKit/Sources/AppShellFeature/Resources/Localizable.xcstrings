    "Show icon in menu bar": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symbol in der Menüleiste anzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show icon in menu bar"
          }
        }
      }
    },
    "Keeps the Dock icon available when the menu bar icon is hidden.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dock-Symbol bleibt verfügbar, wenn das Menüleistensymbol ausgeblendet ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the Dock icon available when the menu bar icon is hidden."
          }
        }
      }
    },
    "Hide Dock icon when windows are closed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock-Symbol bei geschlossenen Fenstern ausblenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide Dock icon when windows are closed"
          }
        }
      }
    },
    "Applies only while the menu bar icon is visible.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur, solange das Menüleistensymbol sichtbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only while the menu bar icon is visible."
          }
        }
      }
    },
    "System integration": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemintegration"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System integration"
          }
        }
      }
    },
    "Closing a window keeps OctoRunner running. Quitting removes its menu bar icon; installed runner LaunchAgents continue running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schließen eines Fensters läuft OctoRunner weiter. Beim Beenden verschwindet das Menüleistensymbol; installierte Runner-LaunchAgents laufen weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a window keeps OctoRunner running. Quitting removes its menu bar icon; installed runner LaunchAgents continue running."
          }
        }
      }
    },
    "Language": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "Changes the interface language without restarting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Sprache der Oberfläche ohne Neustart."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the interface language without restarting."
          }
        }
      }
    },
    "Appearance and language": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung und Sprache"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance and language"
          }
        }
      }
    },
    "Launch at macOS login": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der macOS-Anmeldung starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at macOS login"
          }
        }
      }
    },
    "Registers OctoRunner as a login item for your macOS account.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registriert OctoRunner als Anmeldeobjekt für deinen macOS-Account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registers OctoRunner as a login item for your macOS account."
          }
        }
      }
    },
    "Approve OctoRunner in System Settings → General → Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib OctoRunner unter Systemeinstellungen → Allgemein → Anmeldeobjekte frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve OctoRunner in System Settings → General → Login Items."
          }
        }
      }
    },
    "Login items are unavailable for this app installation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeobjekte sind für diese App-Installation nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Login items are unavailable for this app installation."
          }
        }
      }
    },
    "Enable macOS notifications": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-Mitteilungen aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable macOS notifications"
          }
        }
      }
    },
    "Requests permission only when you enable this setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt erst nach der Erlaubnis, wenn du diese Einstellung aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests permission only when you enable this setting."
          }
        }
      }
    },
    "Notifications are blocked. Allow them for OctoRunner in System Settings → Notifications, then enable this setting again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind blockiert. Erlaube sie für OctoRunner unter Systemeinstellungen → Mitteilungen und aktiviere diese Einstellung erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are blocked. Allow them for OctoRunner in System Settings → Notifications, then enable this setting again."
          }
        }
      }
    },
    "Play notification sounds": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungstöne abspielen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play notification sounds"
          }
        }
      }
    },
    "Uses the macOS default notification sound.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet den Standard-Mitteilungston von macOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the macOS default notification sound."
          }
        }
      }
    },
    "Notification Center": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungszentrale"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification Center"
          }
        }
      }
    },
    "Choose banners or alerts in macOS System Settings. OctoRunner cannot override your system presentation settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Banner oder Hinweise wählst du in den macOS-Systemeinstellungen. OctoRunner kann diese Systemvorgaben nicht überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose banners or alerts in macOS System Settings. OctoRunner cannot override your system presentation settings."
          }
        }
      }
    },
    "Runner goes offline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner geht offline"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner goes offline"
          }
        }
      }
    },
    "Reports a detected transition from online to offline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet einen erkannten Wechsel von online zu offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports a detected transition from online to offline."
          }
        }
      }
    },
    "Local workflow job fails": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Workflow-Job schlägt fehl"
