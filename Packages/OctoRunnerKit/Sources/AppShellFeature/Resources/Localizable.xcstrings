    "Controls when a directly managed runner restarts after a process exit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt fest, wann ein direkt verwalteter Runner nach Prozessende neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls when a directly managed runner restarts after a process exit."
          }
        }
      }
    },
    "Sets the wait before each automatic restart.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Wartezeit vor jedem automatischen Neustart fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the wait before each automatic restart."
          }
        }
      }
    },
    "Failures before quarantine": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlversuche bis zur Quarantäne"
