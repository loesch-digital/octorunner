        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        }
      }
    },
    "Changes the interface language without restarting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Sprache der Oberfläche ohne Neustart."
