        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token-Inhalte und Ablaufdaten werden hier nicht angezeigt. Die Rechte fein abgestufter PATs hängen von den auf GitHub ausgewählten Ressourcen ab."
          }
        }
      }
    },
