    "This runner is currently located at its original folder (%@). Migration copies its configuration into OctoRunner’s Application Support folder. You can also enable automatic startup at login.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Runner liegt in seinem ursprünglichen Ordner (%@). Die Migration kopiert seine Konfiguration in den Application-Support-Ordner von OctoRunner. Du kannst auch den automatischen Start bei der Anmeldung aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runner is currently located at its original folder (%@). Migration copies its configuration into OctoRunner’s Application Support folder. You can also enable automatic startup at login."
          }
        }
      }
    },
