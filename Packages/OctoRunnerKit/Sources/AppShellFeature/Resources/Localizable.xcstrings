          }
        }
      }
    },
    "Uses absolute PATH entries and adds Homebrew tools. When disabled, only system directories are used.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt absolute PATH-Einträge und ergänzt Homebrew-Werkzeuge. Wenn deaktiviert, werden nur Systemverzeichnisse verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses absolute PATH entries and adds Homebrew tools. When disabled, only system directories are used."
          }
        }
      }
    },
