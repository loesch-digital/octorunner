          "stringUnit": {
            "state": "translated",
            "value": "New runner environment"
          }
        }
      }
    },
    "Applies when creating runners. GitHub's startup scripts still use Bash; each workflow defines the shell for its own steps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt beim Erstellen von Runnern. GitHubs Startskripte verwenden weiterhin Bash; jeder Workflow legt die Shell für seine Schritte selbst fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies when creating runners. GitHub's startup scripts still use Bash; each workflow defines the shell for its own steps."
          }
        }
      }
    },
