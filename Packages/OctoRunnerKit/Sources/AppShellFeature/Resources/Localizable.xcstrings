    "GitHub Actions workflows use 'runs-on: [self-hosted, macos, arm64]' to route jobs to matching runners. Click any label below to toggle it or add custom capability tags (like 'fastlane').": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Actions workflows use 'runs-on: [self-hosted, macos, arm64]' to route jobs to matching runners. Click any label below to toggle it or add custom capability tags (like 'fastlane')."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub-Actions-Workflows verwenden „runs-on: [self-hosted, macos, arm64]“, um Jobs passenden Runnern zuzuweisen. Wähle Labels aus oder ergänze eigene Labels (z. B. „fastlane“)."
