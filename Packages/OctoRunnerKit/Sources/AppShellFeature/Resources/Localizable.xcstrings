    "3. Base Runner Prefix & Parallel Instance Count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Base Runner Prefix & Parallel Instance Count"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Namenspräfix & parallele Instanzen"
          }
        }
      }
    },
    "GitHub requires a unique name for each runner. The Base Prefix (e.g. 'mac-runner') is combined with the instance number ('mac-runner-1', 'mac-runner-2'). Each instance gets its own isolated '_work' folder so multiple CI jobs can run in parallel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub requires a unique name for each runner. The Base Prefix (e.g. 'mac-runner') is combined with the instance number ('mac-runner-1', 'mac-runner-2'). Each instance gets its own isolated '_work' folder so multiple CI jobs can run in parallel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub benötigt für jeden Runner einen eindeutigen Namen. Das Präfix (z. B. „mac-runner“) wird mit der Instanznummer kombiniert („mac-runner-1“, „mac-runner-2“). Jede Instanz erhält einen eigenen „_work“-Ordner für parallele CI-Jobs."
          }
        }
      }
    },
    "Base Runner Prefix": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
