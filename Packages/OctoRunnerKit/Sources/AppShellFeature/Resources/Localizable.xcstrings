    "Applies to newly created LaunchAgents. Existing runners keep their installed configuration. A service without automatic restart still starts once at login.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neu erstellte LaunchAgents. Bestehende Runner behalten ihre installierte Konfiguration. Auch ohne automatischen Neustart startet ein Dienst einmal bei der Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to newly created LaunchAgents. Existing runners keep their installed configuration. A service without automatic restart still starts once at login."
          }
        }
      }
    },
    "Installs a runner LaunchAgent that starts at login. The restart policy and PATH come from Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs a runner LaunchAgent that starts at login. The restart policy and PATH come from Settings."
